#!/usr/bin/env python3
from __future__ import annotations

import json
import os
import subprocess
import sys
from datetime import datetime, timedelta
from pathlib import Path
from typing import Any
from zoneinfo import ZoneInfo

SCRIPT_DIR = Path(__file__).resolve().parent
WORKER = SCRIPT_DIR / "crypto_worker"
TIMEZONE = ZoneInfo("America/Chicago")
HOURLY_CRON_NAME = os.environ.get("OPENCLAW_CRYPTO_HOURLY_CRON_NAME", "crypto-sidecar-hourly")
DAILY_BRIEF_CRON_NAME = os.environ.get("OPENCLAW_CRYPTO_DAILY_BRIEF_CRON_NAME", "Kai - Crypto Sidecar Daily Brief")


def run_json(command: list[str]) -> tuple[Any | None, str | None]:
    completed = subprocess.run(command, text=True, capture_output=True)
    if completed.returncode != 0:
      return None, completed.stderr.strip() or completed.stdout.strip() or f"{command[0]} exited with {completed.returncode}"
    try:
      return json.loads(completed.stdout), None
    except json.JSONDecodeError as exc:
      return None, f"Failed to parse JSON from {' '.join(command)}: {exc}"


def fmt_ms(ms: int | None) -> str:
    if not ms:
      return "n/a"
    return datetime.fromtimestamp(ms / 1000, tz=TIMEZONE).strftime("%Y-%m-%d %I:%M %p %Z")


def short_hash(value: str | None) -> str:
    if not value:
      return "n/a"
    if len(value) <= 14:
      return value
    return f"{value[:10]}...{value[-4:]}"


def summarize_reason(value: str | None) -> str:
    if not value:
      return "unknown"
    line = value.strip().splitlines()[0]
    return line if len(line) <= 200 else f"{line[:197]}..."


def line(text: str = "") -> None:
    print(text)


def main() -> int:
    now = datetime.now(TIMEZONE)
    since = now - timedelta(hours=24)
    since_ms = int(since.timestamp() * 1000)

    status, status_error = run_json([str(WORKER), "status"])
    portfolio, portfolio_error = run_json([str(WORKER), "portfolio"])
    history, history_error = run_json([str(WORKER), "history", "--limit", "500"])
    cron_list, cron_error = run_json(["/opt/homebrew/bin/openclaw", "cron", "list", "--json"])

    entries = []
    if history and isinstance(history, dict):
      entries = [
        entry for entry in history.get("entries", [])
        if isinstance(entry, dict) and int(entry.get("timestamp", 0)) >= since_ms
      ]
      entries.sort(key=lambda entry: int(entry.get("timestamp", 0)))

    executed = [entry for entry in entries if entry.get("type") == "trade_executed"]
    simulated = [entry for entry in entries if entry.get("type") == "trade_simulated"]
    rejected = [entry for entry in entries if entry.get("type") == "trade_rejected"]
    failures = [entry for entry in entries if entry.get("type") == "policy_violation"]
    resumes = [entry for entry in entries if entry.get("type") == "resume"]
    pauses = [entry for entry in entries if entry.get("type") == "pause"]

    jobs = cron_list.get("jobs", []) if isinstance(cron_list, dict) else []
    hourly_job = next((job for job in jobs if job.get("name") == HOURLY_CRON_NAME), None)
    daily_job = next((job for job in jobs if job.get("name") == DAILY_BRIEF_CRON_NAME), None)

    line("Kai Crypto Sidecar Daily Brief")
    line(f"Window: {since.strftime('%Y-%m-%d %I:%M %p %Z')} to {now.strftime('%Y-%m-%d %I:%M %p %Z')}")
    line("")

    line("Current status")
    if status_error:
      line(f"- Worker status: error ({status_error})")
    else:
      line(f"- Worker mode: {status.get('executionMode', 'unknown')}")
      line(f"- Worker paused: {status.get('paused', 'unknown')}")
      line(f"- Wallet: {status.get('walletAddress', 'unknown')}")

    if portfolio_error:
      line(f"- Portfolio: error ({portfolio_error})")
    else:
      portfolio_data = portfolio.get("portfolio", {})
      balances = portfolio_data.get("balances", {})
      line(f"- ETH: {portfolio_data.get('nativeEth', {}).get('formatted', '0')}")
      line(f"- USDC: {balances.get('USDC', {}).get('formatted', '0')}")
      line(f"- WETH: {balances.get('WETH', {}).get('formatted', '0')}")
      line(f"- Portfolio USD: {portfolio_data.get('totalUsd', 'n/a')}")
      line(f"- WETH exposure: {portfolio_data.get('wethExposurePct', 'n/a')}%")

    line("")
    line("Last 24 hours")
    if history_error:
      line(f"- History: error ({history_error})")
    else:
      line(f"- Executed trades: {len(executed)}")
      line(f"- Simulated trades: {len(simulated)}")
      line(f"- Rejected trades: {len(rejected)}")
      line(f"- Failed executions: {len(failures)}")
      line(f"- Resume actions: {len(resumes)}")
      line(f"- Pause actions: {len(pauses)}")

    line("")
    line("Hourly autonomy")
    if cron_error:
      line(f"- Cron status: error ({cron_error})")
    elif not hourly_job:
      line(f"- {HOURLY_CRON_NAME}: missing")
    else:
      state = hourly_job.get("state", {})
      line(f"- {HOURLY_CRON_NAME}: {'enabled' if hourly_job.get('enabled') else 'disabled'}")
      line(f"- Last run: {fmt_ms(state.get('lastRunAtMs'))} ({state.get('lastRunStatus', 'n/a')})")
      line(f"- Next run: {fmt_ms(state.get('nextRunAtMs'))}")
      if state.get("lastError"):
        line(f"- Last error: {state.get('lastError')}")
      if state.get("consecutiveErrors") is not None:
        line(f"- Consecutive errors: {state.get('consecutiveErrors')}")

    line("")
    line("Daily brief job")
    if cron_error:
      line(f"- Daily brief cron: error ({cron_error})")
    elif not daily_job:
      line(f"- {DAILY_BRIEF_CRON_NAME}: missing")
    else:
      state = daily_job.get("state", {})
      line(f"- {DAILY_BRIEF_CRON_NAME}: {'enabled' if daily_job.get('enabled') else 'disabled'}")
      line(f"- Last run: {fmt_ms(state.get('lastRunAtMs'))} ({state.get('lastRunStatus', 'n/a')})")
      line(f"- Next run: {fmt_ms(state.get('nextRunAtMs'))}")

    line("")
    line("Notable actions")
    if not executed and not failures and not rejected:
      line("- No trade executions or failures recorded in the last 24 hours.")
    else:
      for entry in executed[-5:]:
        request = entry.get("request", {})
        execution = entry.get("execution", {})
        amount_out = execution.get("amountOut", {})
        line(
          f"- Executed {request.get('side', '?')} ${request.get('notionalUsd', '?')} at {fmt_ms(entry.get('timestamp'))}; "
          f"received {amount_out.get('formatted', '?')} {amount_out.get('symbol', '')}; "
          f"tx {short_hash(execution.get('transactionHash'))}; "
          f"thesis: {request.get('thesis', 'n/a')}"
        )
      for entry in failures[-5:]:
        request = entry.get("request", {})
        line(
          f"- Failed {request.get('side', '?')} ${request.get('notionalUsd', '?')} at {fmt_ms(entry.get('timestamp'))}; "
          f"reason: {summarize_reason(entry.get('reason', 'unknown failure'))}"
        )
      for entry in rejected[-5:]:
        request = entry.get("request", {})
        line(
          f"- Rejected {request.get('side', '?')} ${request.get('notionalUsd', '?')} at {fmt_ms(entry.get('timestamp'))}; "
          f"reason: {summarize_reason(entry.get('reason', 'unknown rejection'))}"
        )

    line("")
    line("Important notes")
    if status and status.get("paused") is True:
      line("- Worker is currently paused between runs by design.")
    if hourly_job and hourly_job.get("enabled") and not status_error and status and status.get("executionMode") == "live":
      line("- Hourly autonomy is armed with the current $5 / $15 daily / 3-trades-per-24h caps.")
    if portfolio and not portfolio_error:
      policy = portfolio.get("policySnapshot", {})
      line(f"- Rolling 24h trade count: {policy.get('rolling24h', {}).get('tradeCount24h', 'n/a')}")
      line(f"- Rolling 24h daily notional: ${policy.get('rolling24h', {}).get('dailyNotionalUsd', 'n/a')}")

    return 0


if __name__ == "__main__":
    sys.exit(main())
